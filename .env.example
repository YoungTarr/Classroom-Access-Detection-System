# =============================================================================
# Classroom Access Detection System - ตัวอย่างค่าตั้งต้น
# วิธีใช้: คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องของคุณ
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / Raspberry Pi:  cp .env.example .env
# ไฟล์ .env จะไม่ถูก commit ขึ้น git (ถูกกันไว้ใน .gitignore แล้ว)
# =============================================================================

# ---------- ฐานข้อมูล PostgreSQL ----------
DB_USER=cads
DB_PASSWORD=change-me-please
DB_NAME=cads

# DB_HOST/DB_PORT ด้านล่างนี้ใช้สำหรับ "เชื่อมต่อจากเครื่อง host" เท่านั้น
# เช่น เปิดด้วย DBeaver / psql บน Windows หรือรัน backend นอก Docker
#
# !! สำคัญ !! เมื่อ backend รันอยู่ใน Docker ค่าพวกนี้ใช้ไม่ได้
#   - localhost ของ container backend คือ "ตัว backend เอง" ไม่ใช่เครื่อง host
#   - จึงต้องต่อด้วย "ชื่อ service" คือ db และพอร์ตภายใน network คือ 5432 เสมอ
# docker-compose.yml จึง override DB_HOST=db และ DB_PORT=5432 ให้อัตโนมัติ
# (ค่าใน environment: ของ compose ชนะค่าจาก env_file เสมอ)
DB_HOST=localhost
DB_PORT=5432

# ---------- แอปพลิเคชัน ----------
# ระดับการ log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# โซนเวลา (ใช้ทั้ง container ฐานข้อมูลและ backend)
TZ=Asia/Bangkok

# รายชื่อ origin ที่อนุญาตให้เรียก API ข้ามโดเมน คั่นด้วยเครื่องหมายจุลภาค
# ปกติไม่จำเป็นต้องใช้ เพราะ nginx ทำ reverse proxy ให้ทุกอย่างอยู่ origin เดียวกัน
# ใส่ไว้เผื่อกรณีเปิดหน้าเว็บจากที่อื่นตอน debug
CORS_ORIGINS=

# ---------- ที่เก็บรูปใบหน้า ----------
# path "ภายใน container" ของ backend (ถูก mount มาจาก ./data/faces บนเครื่อง host)
FACES_DIR=/data/faces

# =============================================================================
# เฟส 2: ตรวจจับใบหน้า
# =============================================================================

# ---------- โมเดลใบหน้า (InsightFace) ----------
# ชุดโมเดล: buffalo_l = แม่นกว่า ใช้ตอน dev / buffalo_s = เล็กเร็วกว่า ใช้บน Raspberry Pi
#
# !! สำคัญ !! ค่านี้ต้องตรงกับ --build-arg FACE_MODEL_PACK ที่ใช้ตอน build image
# เพราะโมเดลถูกดาวน์โหลดฝังไว้ใน image ตั้งแต่ตอน build (ห้ามโหลดตอน runtime)
# ถ้าเปลี่ยนค่านี้ ต้อง build ใหม่ด้วย:
#   docker compose build --build-arg FACE_MODEL_PACK=buffalo_s backend
FACE_MODEL_PACK=buffalo_l

# โฟลเดอร์แม่ที่เก็บชุดโมเดลภายใน container (ปกติไม่ต้องแก้)
FACE_MODELS_DIR=/models/models

# ขนาดภาพที่ป้อนให้ตัวตรวจจับ ยิ่งใหญ่ยิ่งเจอหน้าเล็กได้ดีแต่ช้าลง
# 640 = มาตรฐาน, บน Pi ลองลดเป็น 480 หรือ 320 ถ้าช้าเกินไป
FACE_DET_SIZE=640

# คะแนนขั้นต่ำที่จะนับว่าเป็นใบหน้า (0.0-1.0)
# ต่ำไป = ตรวจเจอของที่ไม่ใช่หน้า, สูงไป = หันหน้าเอียงนิดเดียวก็หลุด
FACE_DET_THRESH=0.5

# จำนวน thread ที่ onnxruntime ใช้ 0 = ให้ตัดสินใจเอง (ใช้ทุก core ที่มี)
#
# !! ควรตั้งเสมอ !! วัดจริงบนเครื่อง dev 12 thread:
#   FACE_NUM_THREADS=0 -> ใช้ 6.3 core, ตรวจจับ 100 ms
#   FACE_NUM_THREADS=4 -> ใช้ 4.0 core, ตรวจจับ 100 ms  <- เร็วเท่ากันแต่ประหยัดกว่ามาก
# การปล่อยเป็น 0 ทำให้ onnxruntime แย่ง core ไปหมดโดยไม่ได้เร็วขึ้นเลย
# Pi 5 มี 4 core ให้ตั้ง 3 เพื่อเหลือ core ให้งานอื่น
FACE_NUM_THREADS=4

# ---------- แหล่งภาพและการสตรีม ----------
# browser = โหมดเว็บแคมเดี่ยว: รับภาพจากเว็บแคมของเครื่องที่เปิดหน้าเว็บ (ไว้ทดสอบตอนไม่มีกล้องเลย)
#           เป็นโหมดของทั้งระบบ ไม่ได้ผูกกับกล้องตัวใดตัวหนึ่ง
# rtsp    = โหมดใช้งานจริง: backend ต่อกล้อง IP ทุกตัวตาม CAMERA_IDS ด้านล่าง
FRAME_SOURCE=browser

# ความกว้างที่ย่อภาพก่อนส่งเข้า backend (พิกเซล)
# ใหญ่เกินไป = ช้าและกินแบนด์วิดท์โดยไม่ได้ความแม่นเพิ่มเท่าไร
STREAM_TARGET_WIDTH=640

# จำนวนเฟรมต่อวินาทีที่เบราว์เซอร์พยายามส่ง (ของจริงขึ้นกับความเร็วในการตรวจจับ)
STREAM_SEND_FPS=10

# คุณภาพ JPEG ตอนเข้ารหัสก่อนส่ง (0.0-1.0)
STREAM_JPEG_QUALITY=0.7

# ภาพเว็บแคมกลับซ้าย-ขวาแบบกระจกเงาหรือไม่
# true = ผู้ใช้เห็นตัวเองเหมือนส่องกระจก (ธรรมชาติกว่าสำหรับเว็บแคม)
# มีผลต่อการวาดกรอบด้วย และจะสำคัญมากในเฟส 5 ตอนคำนวณทิศทางซ้าย/ขวา
CAMERA_MIRROR=true

# =============================================================================
# เฟส 3: ติดตามใบหน้าข้ามเฟรม (tracking)
# =============================================================================

# ค่า IoU (พื้นที่ทับซ้อน/พื้นที่รวม) ขั้นต่ำที่จะถือว่าเป็นใบหน้าเดียวกันข้ามเฟรม
# สูงไป = ขยับเร็วนิดเดียวก็นับเป็นคนใหม่ (id เปลี่ยนบ่อย)
# ต่ำไป = คนสองคนที่ยืนติดกันจะถูกจับสลับ id กัน
TRACK_IOU_THRESHOLD=0.3

# ถ้า IoU ไม่ผ่าน ให้ลองจับคู่ด้วยระยะจุดกึ่งกลางแทน
# ค่านี้คือระยะสูงสุดที่ยอมรับ คิดเป็นสัดส่วนของความกว้างภาพ (ไม่ใช่พิกเซลตายตัว)
TRACK_MAX_CENTER_DISTANCE_RATIO=0.15

# ใบหน้าหายไปกี่เฟรมติดกันจึงจะลบ track ทิ้ง
# นี่คือค่าที่กันกรอบกะพริบ เพราะตัวตรวจจับมักพลาดเป็นครั้งคราว
# (หันหน้า เอามือบัง แสงเปลี่ยน) ถ้าตั้ง 0 กรอบจะกะพริบถี่มาก
TRACK_MAX_MISSING=3

# จำนวนตำแหน่งย้อนหลังที่เก็บต่อหนึ่ง track (เฟส 5 ใช้คำนวณทิศทาง)
TRACK_HISTORY_SIZE=15

# ความนุ่มนวลของการขยับกรอบบนหน้าเว็บ (0.0-1.0)
# ค่าน้อย = ลื่นมากแต่กรอบตามใบหน้าช้า (หน่วง)
# ค่ามาก = ตามไวแต่กระตุกตามผลดิบมากขึ้น
# 1.0 = ไม่ทำ smoothing เลย (กระโดดไปตำแหน่งใหม่ทันที)
TRACK_SMOOTHING=0.35

# =============================================================================
# เฟส 4: จดจำว่าเป็นใคร
# =============================================================================

# วิธีระบุตัวตน ตอนนี้รองรับเฉพาะ face (อนาคตอาจเพิ่ม rfid / qr)
# ใส่ค่าอื่นจะฟ้องตั้งแต่สตาร์ท ไม่แอบใช้ face แทนให้เงียบ ๆ
IDENTIFIER=face

# ชุดโมเดลที่ใช้ "จดจำ" ใบหน้า แยกจากชุดที่ใช้ "ตรวจจับ" (FACE_MODEL_PACK) โดยตั้งใจ
# วัดจริงบนเครื่อง dev:
#   w600k_r50 (buffalo_l) ~167 ms ต่อหนึ่งใบหน้า  <- หนักเกินไป
#   w600k_mbf (buffalo_s) ~ 12 ms ต่อหนึ่งใบหน้า  <- เร็วกว่า 14 เท่า แยกคนได้ดีพอ ๆ กัน
# ต้องตรงกับ --build-arg FACE_REC_PACK ตอน build image
FACE_REC_PACK=buffalo_s

# คะแนน cosine similarity ขั้นต่ำที่จะถือว่า "ใช่คนนี้" (0.0-1.0)
# ทดสอบแล้วคนต่างกันได้คะแนนสูงสุดราว 0.17 จึงเว้นระยะห่างไว้พอสมควร
# สูงไป = คนที่มีในระบบก็ขึ้น Unknown, ต่ำไป = จำสลับคน
SIMILARITY_THRESHOLD=0.35

# เพดานจำนวนใบหน้าที่ส่งเข้าโมเดลจดจำต่อหนึ่งเฟรม
# ใบหน้าที่เกินเพดานจะได้คิวในเฟรมถัดไป (ไม่ได้ถูกทิ้ง)
# บน Pi ถ้าช้าให้ลดเป็น 2
IDENTIFY_MAX_FACES_PER_FRAME=4

# จำนวนผลย้อนหลังที่เก็บไว้โหวตต่อหนึ่ง track
# นี่คือส่วนที่กันชื่อกะพริบ ไม่เชื่อผลของเฟรมเดียว
IDENTITY_VOTE_WINDOW=7

# ต้องได้เสียงข้างมากอย่างน้อยกี่เสียงจึงจะกล้าแสดงชื่อ
# ต่ำไป = ชื่อขึ้นเร็วแต่ผิดง่าย, สูงไป = กว่าจะขึ้นชื่อต้องรอนาน
IDENTITY_MIN_VOTES=3

# track ที่โหวตครบแล้ว จะตรวจซ้ำทุกกี่เฟรม (เผื่อจับผิดคนตั้งแต่แรก)
IDENTITY_RECHECK_INTERVAL=15

# =============================================================================
# เฟส 5: ทิศทางการเคลื่อนที่
# =============================================================================

# !! อ่านให้เข้าใจก่อนเปลี่ยนค่านี้ !!
#
# ภาพบนหน้าเว็บถูกพลิกกระจก (CAMERA_MIRROR) แต่ภาพที่ส่งให้ backend ไม่ได้พลิก
# คำว่า "ซ้าย" จึงมีสองความหมายที่ตรงข้ามกัน
#
#   world  = ซ้าย/ขวาตามที่กล้องเห็นจริง (ภาพดิบ)
#   screen = ซ้าย/ขวาตามที่ผู้ใช้เห็นบนจอ (หลังพลิกกระจกแล้ว) <- ค่าตั้งต้น
#
# ทำไมตั้งต้นเป็น screen: ตอนใช้เว็บแคมป้ายจะตรงกับที่เห็นบนจอ (ถ้าใช้ world
# ป้ายจะบอก "ขวา" ขณะที่กรอบวิ่งไปทางซ้ายบนจอ ดูเหมือนระบบพัง)
# และตอนใช้กล้อง IP จริงที่ไม่พลิกกระจก ทั้งสองแบบให้ผลเหมือนกันทุกประการ
# จึงไม่เสียความถูกต้องของการตัดสิน IN/OUT ในเฟส 6
#
# เฟส 6 จะใช้ทิศทางนี้ตัดสินว่าใคร "เข้า" หรือ "ออก" จากห้อง
# ถ้าตั้งผิด ระบบจะบันทึกเข้า-ออกกลับด้านทั้งหมด ซึ่งหาบั๊กยากมาก
# เพราะทุกอย่างทำงานปกติ แค่ผลกลับด้าน
DIRECTION_REFERENCE=screen

# เทียบตำแหน่งปัจจุบันกับเมื่อกี่เฟรมก่อน
# น้อยไป = ไวแต่สั่นตามการขยับเล็กน้อย, มากไป = นิ่งแต่ตอบสนองช้า
DIRECTION_FRAME_GAP=8

# ระยะขั้นต่ำที่ถือว่า "เคลื่อนที่" คิดเป็นสัดส่วนของความกว้างภาพ
# 0.025 = ต้องเลื่อนเกิน 2.5% ของความกว้างภาพ (16 px บนภาพกว้าง 640)
# ใช้สัดส่วนไม่ใช่พิกเซลตายตัว เพื่อให้ได้ผลเหมือนกันทุกความละเอียด
DIRECTION_MIN_SHIFT_RATIO=0.025

# ตัวคูณลดเกณฑ์เมื่อกำลังเคลื่อนที่อยู่แล้ว (hysteresis)
# กันป้ายกะพริบสลับ เคลื่อนที่ <-> อยู่กับที่ ตอนเดินช้าใกล้เกณฑ์พอดี
DIRECTION_HYSTERESIS=0.6

# จำนวนผลย้อนหลังที่เก็บไว้โหวตทิศทาง
DIRECTION_VOTE_WINDOW=5

# =============================================================================
# เฟส 6 + 9: กล้อง IP (RTSP) - ขาเข้าหนึ่งตัว ขาออกหนึ่งตัว
# =============================================================================
#
# กล้องทุกตัวเป็น TP-Link Tapo C200 ต่อผ่าน RTSP เหมือนกันหมด
# ใช้ชุดตัวแปรหน้าตาเดียวกันเป๊ะ ต่างกันแค่ตัวเลข CAMERA_1_* กับ CAMERA_2_*
#
# **HOST ว่าง = ยังไม่ได้ติดตั้งกล้องตัวนั้น** (เฟส 9)
#   ระบบขึ้นได้ปกติ ไม่พยายามต่อ ไม่ retry ไม่มี log ซ้ำ ๆ
#   หน้าเว็บยังมีจอของกล้องตัวนั้น แต่ขึ้นว่า "ยังไม่ได้ติดตั้งกล้อง" (สีเทา ไม่ใช่สีแดง)
#
# **ตั้ง HOST แล้วแต่ต่อไม่ได้ = กล้องหลุด**
#   หน้าเว็บขึ้นสีแดงพร้อมสาเหตุ และระบบพยายามต่อใหม่ให้เองเรื่อย ๆ
#
# แก้ไฟล์นี้แล้วต้องสั่ง docker compose up -d backend (restart เฉย ๆ ไม่อ่าน .env ใหม่)

# รายชื่อกล้อง คั่นด้วยเครื่องหมายจุลภาค (ไม่ตั้งไว้ = 1,2)
# ลำดับในบรรทัดนี้คือลำดับของจอบนหน้าเว็บ ซ้ายไปขวา
# ชื่อกล้องห้ามซ้ำกัน (ระบบจะฟ้องตั้งแต่ตอนสตาร์ทถ้าซ้ำ)
CAMERA_IDS=1,2

# ---------- ค่ากลางที่กล้องทุกตัวใช้ร่วมกัน ----------
# กล้องตัวไหนไม่ได้ตั้ง USER / PASSWORD / PORT / PATH ของตัวเอง (เว้นว่างไว้)
# จะใช้ค่ากลางชุดนี้แทน
#
# !! สำคัญ !! บัญชีนี้คือ "Camera Account" ที่ตั้งในแอป Tapo
# ไปที่ แอป Tapo > อุปกรณ์ > Settings > Advanced Settings > Camera Account
# ไม่ใช่บัญชี TP-Link ID ที่ใช้ล็อกอินแอป
# (กล้อง Tapo จะยังไม่เปิดพอร์ต 554 จนกว่าจะสร้าง Camera Account นี้)
CAMERA_DEFAULT_USER=
CAMERA_DEFAULT_PASSWORD=
CAMERA_DEFAULT_PORT=554

# /stream1 = ความละเอียดสูง (1080p) ภาพชัดแต่หนักเครื่อง
# /stream2 = ความละเอียดต่ำกว่า เร็วกว่ามาก เหมาะกับการตรวจจับ (ใช้เป็นหลัก)
CAMERA_DEFAULT_PATH=/stream2

# ---------- กล้องตัวที่ 1: ขาเข้า (IN) ----------
#
# !! ระวัง !! ค่า HOST ข้างล่างเป็นแค่ตัวอย่าง ต้องแก้ให้ตรงกับ IP จริงของกล้อง
#
# router แจก IP ให้กล้องแบบ DHCP ซึ่ง "เปลี่ยนเองได้" เมื่อกล้องหรือ router รีสตาร์ท
# พอ IP เปลี่ยนแล้ว หน้าเว็บจะขึ้นว่า "เปิดสตรีมไม่ได้ที่ rtsp://..." ทั้งที่กล้อง
# ยังทำงานปกติดีทุกอย่าง เคยเกิดขึ้นมาแล้วจริงระหว่างพัฒนา
#
# วิธีหา IP ปัจจุบันของกล้อง ดูหัวข้อ "หากล้องไม่เจอ / IP กล้องเปลี่ยนเอง" ใน README
# ทางแก้ถาวรคือตั้ง DHCP reservation ที่ router ผูก IP ไว้กับ MAC ของกล้อง
# เรื่องนี้สำคัญมากตอนย้ายไปรันบน Pi 5 จริง เพราะจะไม่มีใครคอยมาแก้ไฟล์นี้ให้
CAMERA_1_NAME=ประตูทางเข้า
CAMERA_1_HOST=192.168.1.158
CAMERA_1_USER=
CAMERA_1_PASSWORD=
CAMERA_1_PORT=
CAMERA_1_PATH=/stream2
CAMERA_1_DIRECTION=IN
CAMERA_1_ENABLED=true

# ---------- กล้องตัวที่ 2: ขาออก (OUT) ----------
#
# เว้นว่างไว้ถ้ายังไม่ได้ติดตั้งกล้องตัวที่ 2
# (CAMERA_2_HOST ว่าง = หน้าเว็บขึ้น "ยังไม่ได้ติดตั้งกล้อง" และระบบไม่ไปยุ่งกับกล้องตัวนี้เลย)
#
# พอซื้อกล้องมาแล้ว: ตั้ง Camera Account ในแอป Tapo -> ใส่ IP ของกล้องใน CAMERA_2_HOST
# -> docker compose up -d backend  ไม่ต้องแตะโค้ดเลย
#
# ---- อยากทดสอบระบบสองกล้องทั้งที่มีกล้องตัวเดียว ----
# กล้อง Tapo หนึ่งตัวปล่อยได้สองสตรีมพร้อมกัน จึงชี้กล้องตัวที่ 2 ไปที่กล้องตัวเดิม
# แต่ใช้อีก path หนึ่งได้เลย จะเห็นภาพสองจอจากกล้องตัวเดียว:
#   CAMERA_2_HOST=192.168.1.158   (IP เดียวกับกล้องตัวที่ 1)
#   CAMERA_2_PATH=/stream1        (คนละ path กับกล้องตัวที่ 1)
# พอได้กล้องตัวจริงมา เปลี่ยน HOST เป็น IP ของกล้องใหม่ แล้วเปลี่ยน PATH กลับเป็น /stream2
CAMERA_2_NAME=ประตูทางออก
CAMERA_2_HOST=
CAMERA_2_USER=
CAMERA_2_PASSWORD=
CAMERA_2_PORT=
CAMERA_2_PATH=/stream2
CAMERA_2_DIRECTION=OUT
CAMERA_2_ENABLED=true

# ---------- ค่าการเชื่อมต่อ RTSP ----------
# ตัวเลือกที่ส่งให้ FFmpeg ผ่าน OPENCV_FFMPEG_CAPTURE_OPTIONS
#
# rtsp_transport;tcp  สำคัญมาก - กล้อง Tapo ต่อผ่าน Wi-Fi 2.4GHz ซึ่งแพ็กเก็ตหายบ่อย
#                     ถ้าใช้ UDP (ค่าเริ่มต้นของ FFmpeg) ภาพจะแตกเป็นบล็อก ๆ
# stimeout            หน่วยไมโครวินาที บอกให้ FFmpeg ยอมแพ้เองเมื่อรอนานเกินไป
#                     ถ้าไม่ตั้ง การอ่านเฟรมอาจค้างถาวรเมื่อกล้องถูกถอดปลั๊ก
RTSP_FFMPEG_OPTIONS=rtsp_transport;tcp|stimeout;5000000

# ไม่ได้เฟรมใหม่เกินกี่วินาทีถือว่าสตรีมตาย ต้องต่อใหม่
# นี่คือตัวจับกรณี "RTSP ค้างแบบไม่มี error" ซึ่งเช็คจาก read() คืน False ไม่ได้
RTSP_WATCHDOG_TIMEOUT=5.0

# การรอก่อนลองต่อใหม่ เพิ่มเป็นเท่าตัวทุกครั้งที่ล้มเหลว (1, 2, 4, 8, ... จนถึงเพดาน)
RTSP_RECONNECT_INITIAL_DELAY=1.0
RTSP_RECONNECT_MAX_DELAY=30.0

# =============================================================================
# เฟส 7: แยกอัตรา fps ให้ภาพลื่นขึ้น
# =============================================================================

# สามค่านี้แยกอิสระจากกันโดยสิ้นเชิง
#
# เดิมทุกอย่างเดินจังหวะเดียวกัน หน้าเว็บจึงได้ภาพเท่าความเร็วของ AI (~8 fps)
# ซึ่งตาคนเห็นว่ากระตุก แต่ความจริงไม่จำเป็นต้องเท่ากันเลย:
#   - ตำแหน่งใบหน้าเปลี่ยนช้า ตรวจ 5 ครั้ง/วินาที ก็พอ
#   - ส่วนภาพต้องลื่น ควรส่ง 15 ครั้ง/วินาทีขึ้นไป
# เฟรมที่ยังไม่มีผลตรวจใหม่ หน้าเว็บจะ interpolate กรอบต่อเองได้ (กลไกจากเฟส 3)

# อัตราสูงสุดที่ดึงเฟรมจากกล้องมาใช้
# กล้องส่งมา ~15 fps ตั้งต่ำกว่านั้นจะข้ามเฟรมส่วนเกินทิ้งตั้งแต่ต้นทาง
# (ใช้ grab แล้วไม่ retrieve จึงประหยัด CPU จริง ไม่ต้องแปลงสีภาพที่ไม่ได้ใช้)
# บน Raspberry Pi ลองลดเหลือ 8-10
CAPTURE_FPS=15

# อัตราที่ส่งภาพเข้า AI - ขั้นที่แพงที่สุด ตั้งต่ำไว้
# ตั้งแต่เฟส 8 ค่านี้หมายถึง "ต่อกล้องหนึ่งตัว"
DETECT_FPS=5

# เพดานการตรวจจับ "รวมทุกกล้อง" ต่อวินาที (เฟส 8)
#
# ทำไมต้องมีแยกจาก DETECT_FPS: ค่านั้นเป็นความต้องการต่อกล้อง
# แต่ CPU เป็นของทั้งเครื่องร่วมกัน สองกล้องที่ขอกล้องละ 5 = ขอรวม 10
# ซึ่ง Pi 5 อาจทำไม่ไหวเพราะต้องถอดรหัสวิดีโอสองสตรีมไปพร้อมกันด้วย
#
# 0 (หรือไม่ตั้ง) = คิดให้เองเป็น DETECT_FPS x จำนวนกล้องที่เปิดใช้
#                   เท่ากับไม่ได้จำกัดอะไรเพิ่ม
# ตั้งเป็นตัวเลข  = เพดานตายตัว กล้องจะผลัดกันตรวจแบบวนคิวให้อยู่ในงบนี้
#
# บน Raspberry Pi 5 ที่ใช้สองกล้อง ลองเริ่มที่ 6 แล้วดู "อ่าน/ตรวจ/ส่ง" ในหน้าเว็บ
# ถ้าตัวเลข "ตรวจ" ต่ำกว่าที่ตั้งไว้มาก แปลว่าเครื่องเป็นคอขวด ไม่ใช่เพดานนี้
DETECT_FPS_TOTAL=0

# อัตราที่ส่งภาพไปหน้าเว็บ - ตั้งสูงได้เพราะแค่เข้ารหัส JPEG
STREAM_FPS=15

# ผลตรวจเก่าเกินกี่เฟรมของสตรีม จึงเริ่มทำให้กรอบจางลง
# เพื่อบอกผู้ใช้ว่ากำลังเดาตำแหน่งอยู่ ไม่ใช่ผลสด
STALE_AFTER_FRAMES=6
