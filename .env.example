# =============================================================================
# Classroom Access Detection System - ตัวอย่างค่าตั้งต้น
# วิธีใช้: คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องของคุณ
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / Raspberry Pi:  cp .env.example .env
# ไฟล์ .env จะไม่ถูก commit ขึ้น git (ถูกกันไว้ใน .gitignore แล้ว)
# =============================================================================

# ---------- ฐานข้อมูล PostgreSQL ----------
DB_USER=cads
DB_PASSWORD=change-me-please
DB_NAME=cads

# DB_HOST/DB_PORT ด้านล่างนี้ใช้สำหรับ "เชื่อมต่อจากเครื่อง host" เท่านั้น
# เช่น เปิดด้วย DBeaver / psql บน Windows หรือรัน backend นอก Docker
#
# !! สำคัญ !! เมื่อ backend รันอยู่ใน Docker ค่าพวกนี้ใช้ไม่ได้
#   - localhost ของ container backend คือ "ตัว backend เอง" ไม่ใช่เครื่อง host
#   - จึงต้องต่อด้วย "ชื่อ service" คือ db และพอร์ตภายใน network คือ 5432 เสมอ
# docker-compose.yml จึง override DB_HOST=db และ DB_PORT=5432 ให้อัตโนมัติ
# (ค่าใน environment: ของ compose ชนะค่าจาก env_file เสมอ)
DB_HOST=localhost
DB_PORT=5432

# ---------- แอปพลิเคชัน ----------
# ระดับการ log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# โซนเวลา (ใช้ทั้ง container ฐานข้อมูลและ backend)
TZ=Asia/Bangkok

# รายชื่อ origin ที่อนุญาตให้เรียก API ข้ามโดเมน คั่นด้วยเครื่องหมายจุลภาค
# ปกติไม่จำเป็นต้องใช้ เพราะ nginx ทำ reverse proxy ให้ทุกอย่างอยู่ origin เดียวกัน
# ใส่ไว้เผื่อกรณีเปิดหน้าเว็บจากที่อื่นตอน debug
CORS_ORIGINS=

# ---------- ที่เก็บรูปใบหน้า ----------
# path "ภายใน container" ของ backend (ถูก mount มาจาก ./data/faces บนเครื่อง host)
FACES_DIR=/data/faces

# =============================================================================
# เฟส 2: ตรวจจับใบหน้า
# =============================================================================

# ---------- โมเดลใบหน้า (InsightFace) ----------
# ชุดโมเดล: buffalo_l = แม่นกว่า ใช้ตอน dev / buffalo_s = เล็กเร็วกว่า ใช้บน Raspberry Pi
#
# !! สำคัญ !! ค่านี้ต้องตรงกับ --build-arg FACE_MODEL_PACK ที่ใช้ตอน build image
# เพราะโมเดลถูกดาวน์โหลดฝังไว้ใน image ตั้งแต่ตอน build (ห้ามโหลดตอน runtime)
# ถ้าเปลี่ยนค่านี้ ต้อง build ใหม่ด้วย:
#   docker compose build --build-arg FACE_MODEL_PACK=buffalo_s backend
FACE_MODEL_PACK=buffalo_l

# โฟลเดอร์แม่ที่เก็บชุดโมเดลภายใน container (ปกติไม่ต้องแก้)
FACE_MODELS_DIR=/models/models

# ขนาดภาพที่ป้อนให้ตัวตรวจจับ ยิ่งใหญ่ยิ่งเจอหน้าเล็กได้ดีแต่ช้าลง
# 640 = มาตรฐาน, บน Pi ลองลดเป็น 480 หรือ 320 ถ้าช้าเกินไป
FACE_DET_SIZE=640

# คะแนนขั้นต่ำที่จะนับว่าเป็นใบหน้า (0.0-1.0)
# ต่ำไป = ตรวจเจอของที่ไม่ใช่หน้า, สูงไป = หันหน้าเอียงนิดเดียวก็หลุด
FACE_DET_THRESH=0.5

# จำนวน thread ที่ onnxruntime ใช้ 0 = ให้ตัดสินใจเอง
# Pi 5 มี 4 core ลองตั้ง 3 เพื่อเหลือ core ให้งานอื่น
FACE_NUM_THREADS=0

# ---------- แหล่งภาพและการสตรีม ----------
# browser = รับภาพจากเว็บแคมผ่าน WebSocket (เฟส 2)
# rtsp    = อ่านจากกล้อง IP โดยตรง (เฟส 6 ยังไม่รองรับ)
FRAME_SOURCE=browser

# ความกว้างที่ย่อภาพก่อนส่งเข้า backend (พิกเซล)
# ใหญ่เกินไป = ช้าและกินแบนด์วิดท์โดยไม่ได้ความแม่นเพิ่มเท่าไร
STREAM_TARGET_WIDTH=640

# จำนวนเฟรมต่อวินาทีที่เบราว์เซอร์พยายามส่ง (ของจริงขึ้นกับความเร็วในการตรวจจับ)
STREAM_SEND_FPS=10

# คุณภาพ JPEG ตอนเข้ารหัสก่อนส่ง (0.0-1.0)
STREAM_JPEG_QUALITY=0.7

# ภาพเว็บแคมกลับซ้าย-ขวาแบบกระจกเงาหรือไม่
# true = ผู้ใช้เห็นตัวเองเหมือนส่องกระจก (ธรรมชาติกว่าสำหรับเว็บแคม)
# มีผลต่อการวาดกรอบด้วย และจะสำคัญมากในเฟส 5 ตอนคำนวณทิศทางซ้าย/ขวา
CAMERA_MIRROR=true

# =============================================================================
# เฟส 3: ติดตามใบหน้าข้ามเฟรม (tracking)
# =============================================================================

# ค่า IoU (พื้นที่ทับซ้อน/พื้นที่รวม) ขั้นต่ำที่จะถือว่าเป็นใบหน้าเดียวกันข้ามเฟรม
# สูงไป = ขยับเร็วนิดเดียวก็นับเป็นคนใหม่ (id เปลี่ยนบ่อย)
# ต่ำไป = คนสองคนที่ยืนติดกันจะถูกจับสลับ id กัน
TRACK_IOU_THRESHOLD=0.3

# ถ้า IoU ไม่ผ่าน ให้ลองจับคู่ด้วยระยะจุดกึ่งกลางแทน
# ค่านี้คือระยะสูงสุดที่ยอมรับ คิดเป็นสัดส่วนของความกว้างภาพ (ไม่ใช่พิกเซลตายตัว)
TRACK_MAX_CENTER_DISTANCE_RATIO=0.15

# ใบหน้าหายไปกี่เฟรมติดกันจึงจะลบ track ทิ้ง
# นี่คือค่าที่กันกรอบกะพริบ เพราะตัวตรวจจับมักพลาดเป็นครั้งคราว
# (หันหน้า เอามือบัง แสงเปลี่ยน) ถ้าตั้ง 0 กรอบจะกะพริบถี่มาก
TRACK_MAX_MISSING=3

# จำนวนตำแหน่งย้อนหลังที่เก็บต่อหนึ่ง track (เฟส 5 ใช้คำนวณทิศทาง)
TRACK_HISTORY_SIZE=15

# ความนุ่มนวลของการขยับกรอบบนหน้าเว็บ (0.0-1.0)
# ค่าน้อย = ลื่นมากแต่กรอบตามใบหน้าช้า (หน่วง)
# ค่ามาก = ตามไวแต่กระตุกตามผลดิบมากขึ้น
# 1.0 = ไม่ทำ smoothing เลย (กระโดดไปตำแหน่งใหม่ทันที)
TRACK_SMOOTHING=0.35

# =============================================================================
# เฟส 4: จดจำว่าเป็นใคร
# =============================================================================

# วิธีระบุตัวตน ตอนนี้รองรับเฉพาะ face (อนาคตอาจเพิ่ม rfid / qr)
# ใส่ค่าอื่นจะฟ้องตั้งแต่สตาร์ท ไม่แอบใช้ face แทนให้เงียบ ๆ
IDENTIFIER=face

# ชุดโมเดลที่ใช้ "จดจำ" ใบหน้า แยกจากชุดที่ใช้ "ตรวจจับ" (FACE_MODEL_PACK) โดยตั้งใจ
# วัดจริงบนเครื่อง dev:
#   w600k_r50 (buffalo_l) ~167 ms ต่อหนึ่งใบหน้า  <- หนักเกินไป
#   w600k_mbf (buffalo_s) ~ 12 ms ต่อหนึ่งใบหน้า  <- เร็วกว่า 14 เท่า แยกคนได้ดีพอ ๆ กัน
# ต้องตรงกับ --build-arg FACE_REC_PACK ตอน build image
FACE_REC_PACK=buffalo_s

# คะแนน cosine similarity ขั้นต่ำที่จะถือว่า "ใช่คนนี้" (0.0-1.0)
# ทดสอบแล้วคนต่างกันได้คะแนนสูงสุดราว 0.17 จึงเว้นระยะห่างไว้พอสมควร
# สูงไป = คนที่มีในระบบก็ขึ้น Unknown, ต่ำไป = จำสลับคน
SIMILARITY_THRESHOLD=0.35

# เพดานจำนวนใบหน้าที่ส่งเข้าโมเดลจดจำต่อหนึ่งเฟรม
# ใบหน้าที่เกินเพดานจะได้คิวในเฟรมถัดไป (ไม่ได้ถูกทิ้ง)
# บน Pi ถ้าช้าให้ลดเป็น 2
IDENTIFY_MAX_FACES_PER_FRAME=4

# จำนวนผลย้อนหลังที่เก็บไว้โหวตต่อหนึ่ง track
# นี่คือส่วนที่กันชื่อกะพริบ ไม่เชื่อผลของเฟรมเดียว
IDENTITY_VOTE_WINDOW=7

# ต้องได้เสียงข้างมากอย่างน้อยกี่เสียงจึงจะกล้าแสดงชื่อ
# ต่ำไป = ชื่อขึ้นเร็วแต่ผิดง่าย, สูงไป = กว่าจะขึ้นชื่อต้องรอนาน
IDENTITY_MIN_VOTES=3

# track ที่โหวตครบแล้ว จะตรวจซ้ำทุกกี่เฟรม (เผื่อจับผิดคนตั้งแต่แรก)
IDENTITY_RECHECK_INTERVAL=15

# =============================================================================
# เฟส 5: ทิศทางการเคลื่อนที่
# =============================================================================

# !! อ่านให้เข้าใจก่อนเปลี่ยนค่านี้ !!
#
# ภาพบนหน้าเว็บถูกพลิกกระจก (CAMERA_MIRROR) แต่ภาพที่ส่งให้ backend ไม่ได้พลิก
# คำว่า "ซ้าย" จึงมีสองความหมายที่ตรงข้ามกัน
#
#   world  = ซ้าย/ขวาตามที่กล้องเห็นจริง (ภาพดิบ)
#   screen = ซ้าย/ขวาตามที่ผู้ใช้เห็นบนจอ (หลังพลิกกระจกแล้ว) <- ค่าตั้งต้น
#
# ทำไมตั้งต้นเป็น screen: ตอนใช้เว็บแคมป้ายจะตรงกับที่เห็นบนจอ (ถ้าใช้ world
# ป้ายจะบอก "ขวา" ขณะที่กรอบวิ่งไปทางซ้ายบนจอ ดูเหมือนระบบพัง)
# และตอนใช้กล้อง IP จริงที่ไม่พลิกกระจก ทั้งสองแบบให้ผลเหมือนกันทุกประการ
# จึงไม่เสียความถูกต้องของการตัดสิน IN/OUT ในเฟส 6
#
# เฟส 6 จะใช้ทิศทางนี้ตัดสินว่าใคร "เข้า" หรือ "ออก" จากห้อง
# ถ้าตั้งผิด ระบบจะบันทึกเข้า-ออกกลับด้านทั้งหมด ซึ่งหาบั๊กยากมาก
# เพราะทุกอย่างทำงานปกติ แค่ผลกลับด้าน
DIRECTION_REFERENCE=screen

# เทียบตำแหน่งปัจจุบันกับเมื่อกี่เฟรมก่อน
# น้อยไป = ไวแต่สั่นตามการขยับเล็กน้อย, มากไป = นิ่งแต่ตอบสนองช้า
DIRECTION_FRAME_GAP=8

# ระยะขั้นต่ำที่ถือว่า "เคลื่อนที่" คิดเป็นสัดส่วนของความกว้างภาพ
# 0.025 = ต้องเลื่อนเกิน 2.5% ของความกว้างภาพ (16 px บนภาพกว้าง 640)
# ใช้สัดส่วนไม่ใช่พิกเซลตายตัว เพื่อให้ได้ผลเหมือนกันทุกความละเอียด
DIRECTION_MIN_SHIFT_RATIO=0.025

# ตัวคูณลดเกณฑ์เมื่อกำลังเคลื่อนที่อยู่แล้ว (hysteresis)
# กันป้ายกะพริบสลับ เคลื่อนที่ <-> อยู่กับที่ ตอนเดินช้าใกล้เกณฑ์พอดี
DIRECTION_HYSTERESIS=0.6

# จำนวนผลย้อนหลังที่เก็บไว้โหวตทิศทาง
DIRECTION_VOTE_WINDOW=5
